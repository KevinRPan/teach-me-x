{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learning-companion",
  "account_id": "7a7eaf5be01796506a62c4d9b17c06c4",
  "workers_dev": true,
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.js",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    },
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // GEMINI_API_KEY is a Worker secret. Leave it unset and the phone stays in practice mode.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learning-companion",
      "database_id": "8bcb574a-52ce-41a5-9f6c-de235e1a2880",
      "migrations_dir": "d1"
    }
  ]
}
